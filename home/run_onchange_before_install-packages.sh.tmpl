#!/bin/bash
# Installs packages whenever the package lists change. chezmoi re-runs this
# script when the hashes below change (that's the whole trick).
#
# Brewfile hash: {{ include "private_dot_config/packages/Brewfile" | sha256sum }}
# apt.txt hash: {{ include "private_dot_config/packages/apt.txt" | sha256sum }}

set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
if command -v brew >/dev/null; then
  echo ">> brew bundle (this can take a while on first run)"
  brew bundle --file="{{ .chezmoi.sourceDir }}/private_dot_config/packages/Brewfile" || true
else
  echo ">> Homebrew not installed; skipping packages. https://brew.sh"
fi
{{ else if eq .chezmoi.os "linux" -}}
if command -v apt-get >/dev/null; then
  echo ">> apt install"
  # Skip packages this release doesn't carry (e.g. eza/git-delta on 22.04);
  # one unknown name would otherwise fail the whole install.
  avail=() skipped=()
  while read -r pkg; do
    if apt-cache policy "$pkg" 2>/dev/null | grep -q 'Candidate: [^(]'; then
      avail+=("$pkg")
    else
      skipped+=("$pkg")
    fi
  done < <(grep -vE '^\s*(#|$)' "{{ .chezmoi.sourceDir }}/private_dot_config/packages/apt.txt")
  [ "${#skipped[@]}" -gt 0 ] && echo ">> no apt candidate, install another way: ${skipped[*]}"
  sudo apt-get install -y "${avail[@]}"
fi
{{ end -}}

# tmux plugin manager — tmux.conf runs tpm from ~/.config/tmux/plugins
# (tpm's default location for configs under ~/.config/tmux)
if [ ! -d "$HOME/.config/tmux/plugins/tpm" ]; then
  git clone --depth=1 https://github.com/tmux-plugins/tpm "$HOME/.config/tmux/plugins/tpm"
fi

# starship config is optional; a default prompt is fine to start.
exit 0
