[user]
	email = echelon@gmail.com
	name = Brandon Thomas
[core]
	editor = nvim
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[column]
	ui = auto
{{ if lookPath "delta" -}}
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
{{- end }}
