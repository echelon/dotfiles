[user]
	email = echelon@gmail.com
	name = Brandon Thomas
[core]
	editor = nvim
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[merge]
	{{- /* zdiff3 needs git >= 2.35 (Ubuntu 22.04 ships 2.34); older git
	       hard-errors on it, breaking every merge and even plugin managers
	       that shell out to git. Fall back to diff3 there. */}}
	{{- $gitVer := regexFind `[0-9]+\.[0-9]+\.[0-9]+` (output "git" "--version") }}
	{{- if semverCompare ">=2.35.0" $gitVer }}
	conflictstyle = zdiff3
	{{- else }}
	conflictstyle = diff3
	{{- end }}
[diff]
	colorMoved = default
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[column]
	ui = auto
{{ if lookPath "delta" -}}
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
{{- end }}
